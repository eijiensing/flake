// Desktop monitor layout, migrated from Hyprland (hosts/desktop/hyprland-host-config.lua).
// Max refresh rates are taken from `niri msg outputs`; if you drop the "@<hz>"
// suffix, niri automatically picks the highest refresh rate for the resolution.

output "HDMI-A-1" {
    // LG Electronics LG FHD. 100 Hz is advertised but the panel shows
    mode "1920x1080@100.000"
    position x=0 y=0
    scale 1.0
}

output "DP-3" {
    // PNP(AOC) 24G2W1G4 — max 144 Hz
    mode "1920x1080@144.001"
    position x=1920 y=0
    scale 1.0

    // This output also supports adaptive sync (VRR); enable it with:
    // adaptive-sync true
}
